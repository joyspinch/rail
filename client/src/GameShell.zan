using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Game.Foundation;
using Game.Foundation.Gui;

// 铁轨快递 · RAIL 的外壳：存档（最高得分 / 累计送达 / 通关次数 / 出场次数）
// + 设置（音效 / 自动调度 / 调度建议 / 严格时限）+ 设置浮层。
//
// 存档基座（原子写 + 备份回退 + 版本号）与设置逻辑层（档位计算 + 校验 +
// 落盘）都在公共包 Game.Foundation 里；这里只留"这个游戏存什么、设置有哪
// 几项"——换个游戏换的正是这两行。
public class GameShell {
    GameSaveStore store;
    GameSettings settings;
    SettingsModel model;
    SettingsOverlay overlay;
    int bestScore;        // 历史最高得分
    int totalDelivered;   // 累计送达货物数
    int clears;           // 全线贯通（3 关全过）次数
    int runs;             // 出场次数

    public GameShell() {
        string dir = GameShell.SaveDir();
        Directory.CreateDirectory(dir);
        this.store = new GameSaveStore(dir, "rail", 1);
        this.settings = new GameSettings().At(dir + "/settings.json");
        this.settings.AddBool("sfx", "音效", true);
        this.settings.AddBool("autoDrive", "自动调度", false);
        this.settings.AddBool("hint", "调度建议", true);
        this.settings.AddBool("strict", "严格时限", false);
        this.settings.Load();
        this.model = new SettingsModel(this.settings);
        this.overlay = new SettingsOverlay(this.model);
        this.overlay.SetTitle("设置");
        this.Load();
    }

    // 存档目录：%LOCALAPPDATA%/Rail（可用 RAIL_SAVE 环境变量覆盖，
    // 测试脚本靠它把存档落在临时目录里，不污染玩家机器）。
    static string SaveDir() {
        string overridden = Environment.GetEnvironmentVariable("RAIL_SAVE");
        if (overridden != "") { return overridden; }
        string basePath = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        if (basePath == "") { basePath = Directory.GetCurrentDirectory(); }
        return basePath + "/Rail";
    }

    public SettingsOverlay Overlay() { return this.overlay; }
    public int BestScore() { return this.bestScore; }
    public int TotalDelivered() { return this.totalDelivered; }
    public int Clears() { return this.clears; }
    public int Runs() { return this.runs; }

    // 设置项（面板改完立刻生效——每帧读当前值）。
    public bool Sfx() {
        if (this.settings == null) { return true; }
        return this.settings.GetBool("sfx");
    }

    public bool AutoDrive() {
        if (this.settings == null) { return false; }
        return this.settings.GetBool("autoDrive");
    }

    public bool Hint() {
        if (this.settings == null) { return true; }
        return this.settings.GetBool("hint");
    }

    public bool Strict() {
        if (this.settings == null) { return false; }
        return this.settings.GetBool("strict");
    }

    // 读档：没有存档就用默认值，不报错。
    public void Load() {
        JsonValue data = this.store.Load(0);
        if (data == null) {
            this.bestScore = 0;
            this.totalDelivered = 0;
            this.clears = 0;
            this.runs = 0;
            return;
        }
        this.bestScore = data.Int("bestScore", 0);
        this.totalDelivered = data.Int("totalDelivered", 0);
        this.clears = data.Int("clears", 0);
        this.runs = data.Int("runs", 0);
    }

    // 最高得分只增不减。
    public void RecordScore(int score) {
        if (score > this.bestScore) { this.bestScore = score; }
    }

    // 累计送达只增不减。
    public void RecordDelivered(int count) {
        if (count > 0) { this.totalDelivered = this.totalDelivered + count; }
    }

    // 通关次数 +1。
    public void RecordClear() {
        this.clears = this.clears + 1;
    }

    // 存档：最高得分与累计量在内存里已更新，这里落盘；出场次数 +1。
    public void Save() {
        JsonValue data = JsonValue.NewObject();
        data.PutInt("bestScore", this.bestScore);
        data.PutInt("totalDelivered", this.totalDelivered);
        data.PutInt("clears", this.clears);
        data.PutInt("runs", this.runs + 1);
        this.runs = this.runs + 1;
        this.store.Save(0, data);
    }
}
