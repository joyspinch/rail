using System;
using Gui;
using Game.Foundation.Gui;

// 铁轨快递 · RAIL 入口：建宿主 → 跑主循环。
//
// 环境变量：
//   RAIL_SMOKE=1   无头冒烟（跑满 RAIL_FRAMES 帧后自行退出）
//   RAIL_FRAMES=n  冒烟帧数（默认 300）
//   RAIL_DEMO=1    演示模式：直接进第 1 关并开启自动调度（截图/验收用）
//   RAIL_SAVE=dir  覆盖存档目录（测试脚本用）
//   RAIL_CAPTURE=p 抓画布像素到 .zpx（调试用）
public class RailApp {
    static void Main() {
        RailGame game = new RailGame();
        GuiHost host = new GuiHost("铁轨快递 · RAIL", 1280, 800, 16);
        host.Run(game);
    }
}
